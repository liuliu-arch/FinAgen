# OpenAI-compatible reasoning model used by the ReAct agents and summarizer.
OPENAI_COMPATIBLE_API_KEY=your_api_key_here
OPENAI_COMPATIBLE_BASE_URL=https://api.deepseek.com
OPENAI_COMPATIBLE_MODEL=your_model_name
USE_LOCAL_MODEL=api

# Optional overrides for the local Qwen3-8B base model and LoRA adapters.
# Relative paths are resolved by your shell, so absolute paths are recommended.
FINANCE_MODEL_PATH=/path/to/Qwen3-8B
FINANCE_SENTIMENT_ADAPTER=/path/to/qwen3_8b_sentiment_final
FINANCE_RISK_ADAPTER=/path/to/qwen3_8b_risk_final

